# Root environment template for the Multi-Agent Plastic Surgery Consultation System

# Google Gemini API Key (required) — shared by backend dialog + embeddings
GOOGLE_API_KEY=your_google_api_key_here

# CORS origins allowed by the backend ("*" or comma-separated list)
ALLOWED_ORIGINS=*

# Frontend API base URL (used by the Vite app)
VITE_API_URL=http://localhost:3000/api

# Optional: PostgreSQL URL for pgvector RAG (surgeon knowledge base)
# DATABASE_URL=postgres://user:pass@host:5432/plastic_consult
