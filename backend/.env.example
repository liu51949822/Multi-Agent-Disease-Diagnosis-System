# Google Gemini API configuration (dialog + embeddings)
GOOGLE_API_KEY=your_google_api_key_here

# Server
PORT=3000
NODE_ENV=production

# CORS ("*" or comma-separated origins)
ALLOWED_ORIGINS=*

# Optional: PostgreSQL URL for pgvector RAG (plastic surgery knowledge base).
# When unset, the surgeon agent degrades to general LLM guidance.
# DATABASE_URL=postgres://user:pass@host:5432/plastic_consult

# Optional: pino log level
# LOG_LEVEL=info

# ---- LangSmith 追踪（可选） ----
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_PROJECT=plastic-surgery-agent
